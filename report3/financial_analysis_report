<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>测试公司 专业级财务分析报告</title>
  <style>
    :root {
      --navy:#062B5F; --primary:#1769F5; --cyan:#13B7B9; --orange:#FF9F2E; --purple:#5B5CE2;
      --green:#18A058; --red:#E5484D; --yellow:#F7B731; --ink:#14213D; --muted:#667085;
      --bg:#EEF5FF; --card:#FFFFFF; --line:#DDE8F7;
    }
    * { box-sizing:border-box; }
    body { margin:0; font-family:Arial,"Microsoft YaHei","Source Han Sans SC",sans-serif; color:var(--ink); background:var(--bg); }
    main { width:min(1320px,calc(100vw - 56px)); margin:0 auto; padding:30px 0 44px; }
    header { display:flex; justify-content:space-between; gap:18px; align-items:flex-start; margin-bottom:18px; }
    h1,h2,h3,p { margin-top:0; }
    h1 { margin-bottom:8px; font-size:30px; font-weight:900; }
    h2 { font-size:21px; margin-bottom:14px; color:var(--navy); font-weight:900; }
    h3 { margin:18px 0 10px; color:var(--navy); }
    header p,.basis { color:var(--muted); line-height:1.8; }
    .tag { border:1px solid var(--line); border-radius:999px; padding:10px 16px; background:#fff; color:var(--muted); font-weight:800; white-space:nowrap; }
    .kpis { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:14px; margin-bottom:16px; }
    .card,.panel,.summary-card { background:var(--card); border:1px solid var(--line); border-radius:14px; box-shadow:0 8px 20px rgba(21,91,180,.06); }
    .card { padding:16px; min-height:172px; transition:.18s ease; }
    .card:hover,.panel:hover { transform:translateY(-1px); box-shadow:0 12px 28px rgba(21,91,180,.10); }
    .label { color:var(--muted); font-weight:900; font-size:13px; }
    .value { font-size:22px; font-weight:900; margin:7px 0; }
    .sub { font-size:12px; font-weight:800; color:var(--muted); line-height:1.6; }
    .risk-pill { display:inline-flex; margin-top:8px; border-radius:999px; padding:4px 9px; color:#fff; font-size:12px; font-weight:900; }
    .risk-green { background:var(--green); } .risk-yellow { background:var(--yellow); color:#4A3A00; } .risk-red { background:var(--red); }
    details { margin-top:8px; color:#344054; font-size:12px; line-height:1.55; }
    summary { cursor:pointer; font-weight:800; color:var(--primary); }
    .panel { padding:22px; margin-bottom:16px; overflow:hidden; }
    .summary-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; margin-bottom:16px; }
    .summary-card { padding:18px; line-height:1.7; }
    .summary-card strong { color:var(--navy); }
    .chart-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; }
    .chart-panel svg { width:100%; height:auto; display:block; }
    .chart-title { font-size:18px; font-weight:900; fill:var(--navy); }
    .chart-note { font-size:12px; fill:var(--muted); }
    .legend { display:flex; flex-wrap:wrap; gap:14px; margin-top:8px; color:var(--muted); font-size:13px; font-weight:800; }
    .dot { display:inline-block; width:10px; height:10px; border-radius:999px; margin-right:6px; }
    table { width:100%; border-collapse:collapse; table-layout:fixed; }
    th,td { padding:12px 14px; border-bottom:1px solid var(--line); text-align:left; vertical-align:top; line-height:1.6; font-size:14px; }
    th { background:#F3F8FF; color:var(--navy); font-weight:900; }
    td:first-child { font-weight:900; }
    .warning { color:var(--red); font-weight:800; }
    @media (max-width:1180px) {
      main { width:min(100vw - 28px,760px); }
      header { flex-direction:column; }
      .kpis,.summary-grid,.chart-grid { grid-template-columns:1fr; }
      table { table-layout:auto; }
    }
  </style>
</head>
